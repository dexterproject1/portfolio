@model ProjectDetails
@{
    ViewData["Title"] = Model.Project.Title;

    // Turn a YouTube link into the id of an embeddable player.
    var videoId = System.Text.RegularExpressions.Regex.Match(Model.Project.VideoUrl ?? "", @"(?:v=|youtu\.be/|shorts/)([A-Za-z0-9_-]{11})").Groups[1].Value;
}

<h1 class="mb-1">@Model.Project.Title</h1>
<p class="text-muted">@Model.Project.CourseCode · @Model.Project.YearMade</p>
<p>@(Model.Project.Description ?? "No description.")</p>

<h2 class="h5 mt-4">Images</h2>
@if (Model.Images.Count == 0)
{
    <p>This project has no images.</p>
}
else
{
    <div class="row g-3">
        @foreach (var image in Model.Images)
        {
            <div class="col-md-4">
                <img src="@image.ImageUrl" class="img-fluid rounded" alt="@Model.Project.Title" />
            </div>
        }
    </div>
}

@if (videoId != "")
{
    <h2 class="h5 mt-4">Video</h2>
    <iframe width="560" height="315" src="https://www.youtube.com/embed/@videoId" title="Project demo" allowfullscreen></iframe>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-link px-0">Back to projects</a>
</div>