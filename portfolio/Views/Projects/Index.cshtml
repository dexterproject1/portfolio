@model List<Project>
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Projects</h1>
    <a asp-action="Create" class="btn btn-primary">Add a project</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Course</th>
            <th>Title</th>
            <th>Year</th>
            <th style="width:14rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.CourseCode</td>
                <td>@project.Title</td>
                <td>@project.YearMade</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>