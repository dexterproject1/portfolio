@model List<Course>
@{
    ViewData["Title"] = "Courses";
}

<h1 class="mb-3">Courses</h1>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Code</th>
            <th>Title</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Code</td>
                <td>@course.Title</td>
                <td>@(course.Description ?? "—")</td>
            </tr>
        }
    </tbody>
</table>