@model List<Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Courses</h1>
    <a asp-action="Create" class="btn btn-primary">Add a course</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Code</th>
            <th>Title</th>
            <th>Description</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Code</td>
                <td>@course.Title</td>
                <td>@(course.Description ?? "—")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>