@model Course
@{
    ViewData["Title"] = "Delete a course";
}

<h1 class="mb-3">Delete a course</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card card-body" style="max-width:36rem">
    <p>Are you sure you want to delete this course?</p>
    <dl class="row mb-2">
        <dt class="col-4">Code</dt>
        <dd class="col-8">@Model.Code</dd>
        <dt class="col-4">Title</dt>
        <dd class="col-8">@Model.Title</dd>
        <dt class="col-4">Description</dt>
        <dd class="col-8">@(Model.Description ?? "—")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.CourseId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>